# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# omc: состояние пишется и во вложенных папках, поэтому шаблон не якорим
.omc/

# shadcn registry build output
/public/r/

# playwright mcp artifacts
/.playwright-mcp/

# локальные материалы: бизнес-документы и секреты, в репозиторий не идут
/local/
# Черновые скрипты проверок из сессий агентов
/artifacts/

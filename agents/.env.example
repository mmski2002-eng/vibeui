DATABASE_URL=postgres://user:password@localhost:5432/vibeui_agents
OPENAI_API_KEY=
OPENAI_SCORING_MODEL=gpt-6-luna
OPENAI_GENERATION_MODEL=gpt-6.1-sol
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HARD_MODEL_BUDGET_USD=0.80
YOUTUBE_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OUTREACH_EMAIL_FROM=VibeUI <partners@vibeui.club>
VIBEUI_INTERNAL_API_KEY=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4310
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password
WORKER_POLL_MS=3000
POLICY_PATH=./policy/default-policy.json

# Поиск Telegram-каналов по словам: аккаунт Telegram (my.telegram.org → API development tools).
# TELEGRAM_SESSION выдаёт `npm run telegram-login` один раз.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Поиск Telegram-каналов через поисковики («<запрос> site:t.me»), без Telegram-аккаунта.
# Яндекс: console.yandex.cloud → Search API → API-ключ; ID каталога b1g…
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Brave: api-dashboard.search.brave.com → API Keys (поставьте лимит расходов $5)
BRAVE_SEARCH_API_KEY=

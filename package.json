{
  "name": "vibeui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run indexes && npm run meta:validate && npm run registry:build && next build --turbopack",
    "meta:validate": "node scripts/validate-meta.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:build": "node -e \"require('node:fs').rmSync('public/r',{recursive:true,force:true})\" && shadcn build && node scripts/strip-preview.mjs",
    "indexes": "node scripts/build-indexes.mjs",
    "indexes:check": "node scripts/build-indexes.mjs --check",
    "predev": "npm run indexes",
    "item": "node scripts/new-item.mjs",
    "audit": "node scripts/audit-ui.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

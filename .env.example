# Базовый URL публичного shadcn-registry: <origin>/r
# Используется для install-команды на страницах компонентов и в Copy for AI.
# В development не обязателен — подставляется http://localhost:3000/r.
# В production без него UI честно сообщает, что команда недоступна.
# Значение вшивается на сборке: после изменения нужен редеплой.
REGISTRY_BASE_URL=https://example.vercel.app/r

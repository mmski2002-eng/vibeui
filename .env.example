# Базовый URL публичного shadcn-registry: <origin>/r
# Используется для install-команды на страницах компонентов и в Copy for AI.
# В development не обязателен — подставляется http://localhost:3000/r.
# В production без него UI честно сообщает, что команда недоступна.
# Значение вшивается на сборке: после изменения нужен редеплой.
REGISTRY_BASE_URL=https://example.vercel.app/r

# Канонический origin сайта. Нужен для canonical, hreflang, sitemap и OG.
# По умолчанию https://vibeui.ru — переопределять только на другом домене.
NEXT_PUBLIC_SITE_URL=https://vibeui.ru

# Счётчики. Пусто — счётчик не рендерится вообще.
# Номер счётчика Яндекс.Метрики (только цифры).
NEXT_PUBLIC_YM_ID=
# Идентификатор потока Google Analytics 4 (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# Подтверждение прав в кабинетах. Значение атрибута content из meta-тега.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# База данных: PostgreSQL на том же сервере, что и приложение.
# Формат: postgresql://пользователь:пароль@127.0.0.1:5432/имя_базы
DATABASE_URL=

# Секрет для подписи сессий Better Auth. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Внешний адрес сайта: по нему собираются ссылки в письмах.
BETTER_AUTH_URL=https://vibeui.ru

# Почта для писем подтверждения и сброса пароля.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VibeUI <noreply@vibeui.ru>"

# ЮKassa: магазин и секретный ключ из личного кабинета.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Ключ для таймера продления подписок: с ним ходит systemd-таймер сервера.
CRON_SECRET=
